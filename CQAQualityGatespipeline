pipeline {
    agent any
    tools {
        maven 'mymaven'
    }
    stages {
        stage('Code') {
            steps {
                git "https://github.com/sivakumarkalava/one.git"
            }
        }
        stage ('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage ('CQA') {
            steps {
                 withSonarQubeEnv('mysonar') {
                     sh "mvn clean verify sonar:sonar -Dsonar.projectKey=Myproject"
                 }
            }
        }
        stage ("QualityGates"){
            steps{
                waitForQualityGate abortPipeline: true, credentialsId: 'sonarcred'
            }
        }
        stage ('Artifact') {
            steps {
                echo 'this is artifact stage'
            }
        }
        stage ('Deploy') {
            steps {
                echo 'this is deploy stage'
            }
        }
    }
}
